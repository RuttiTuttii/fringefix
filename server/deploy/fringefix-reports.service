[Unit]
Description=fringefix anonymous report receiver
After=network-online.target docker.service
Wants=network-online.target

[Service]
# отдельный пользователь создаётся на лету, ему принадлежит только папка с отчётами
DynamicUser=yes
StateDirectory=fringefix-reports
StateDirectoryMode=0700
WorkingDirectory=/opt/fringefix-reports
Environment=PYTHONPATH=/opt/fringefix-reports
Environment=FRINGEFIX_REPORTS_DIR=/var/lib/fringefix-reports
# адрес привязки подставляет deploy.sh: адрес моста docker, чтобы до приёмника дотягивался только Caddy в контейнере
Environment=FRINGEFIX_BIND=127.0.0.1
Environment=FRINGEFIX_PORT=8791
ExecStart=/usr/bin/python3 -m fringefix_reports
# мост docker может подняться позже сервиса, поэтому при сбое привязки пробуем снова
Restart=always
RestartSec=5

# изоляция: сервис не видит остальную систему и не может ничего, кроме приёма на своём порту
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
