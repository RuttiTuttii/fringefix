[Unit]
Description=fringefix anonymous report receiver
After=network.target

[Service]
# отдельный пользователь создаётся на лету, ему принадлежит только папка с отчётами
DynamicUser=yes
StateDirectory=fringefix-reports
StateDirectoryMode=0700
WorkingDirectory=/opt/fringefix-reports
Environment=PYTHONPATH=/opt/fringefix-reports
Environment=FRINGEFIX_REPORTS_DIR=/var/lib/fringefix-reports
Environment=FRINGEFIX_BIND=127.0.0.1
Environment=FRINGEFIX_PORT=8791
ExecStart=/usr/bin/python3 -m fringefix_reports
Restart=on-failure
RestartSec=5

# изоляция: сервис не видит остальную систему и не может ничего, кроме приёма на локальном порту
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
